# Sanity CMS configuration
#
# Set these in your local environment (recommended: a `.env` file in the repo root)
# and in the Vercel project settings under Environment Variables.
#
# Required — used by the server when querying the Content Lake.
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_VERSION=2026-01-01

# Required — needed by the embedded Sanity Studio admin (browser-build safe).
# Mirrors SANITY_PROJECT_ID so the Studio at /studio can render in the browser.
VITE_SANITY_PROJECT_ID=

# Optional — include only if your dataset is not publicly readable.
SANITY_READ_TOKEN=

# Required for running `node scripts/seed-content.mjs` (writing content).
SANITY_WRITE_TOKEN=

# Optional — helps failure diagnostics.
SANITY_TAG=cmda-website

# Admin governance layer (RBAC + auth + audit)
# ============================================================
#
# The site keeps Sanity as the content source of truth. This separate
# Postgres database (e.g. Neon) holds admin users, roles, permissions,
# role/scope assignments, sessions and the audit log.
#
# Required — connection string for the admin governance Postgres database.
ADMIN_DATABASE_URL=

# Required — used by `node scripts/admin-migrate.mjs` / `admin-bootstrap.mjs`
# only, to create the first Super Admin account.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_NAME=CMDA Super Admin
ADMIN_BOOTSTRAP_PASSWORD=

# Optional — session lifetime in milliseconds (default 7 days).
# ADMIN_SESSION_TTL_MS=604800000